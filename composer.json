{
    "name": "doniixify/doniixify",
    "description": "Self-hosted music streaming PWA with Subsonic-compatible API, YouTube/Spotify downloader, and collaborative playback.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "Doniixify\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
