APP_NAME=Doniixify
APP_VERSION=0.1.0
APP_DEBUG=false

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doniixify
DB_USER=doniixify
DB_PASS=

# Storage paths (absolute)
MUSIC_PATH=/var/www/doniixify/storage/music
COVER_CACHE_PATH=/var/www/doniixify/storage/covers

# External binaries
YT_DLP_BIN=/usr/local/bin/yt-dlp
FFMPEG_BIN=/usr/bin/ffmpeg

AUDIO_QUALITY=best

# Subsonic-compatible API
SUBSONIC_API_VERSION=1.16.1
SUBSONIC_SERVER_NAME=Doniixify

# Spotify Web API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API (https://www.last.fm/api/account/create)
# Use either LASTFM_SECRET or LASTFM_SHARED_SECRET (both accepted)
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Web Push VAPID keys (https://web-push-codelab.glitch.me/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
